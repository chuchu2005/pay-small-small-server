# Copy to .env for local runs, or set these as environment variables on your host.

# Port (Render/Railway set this automatically; locally defaults to 8080)
PORT=8080

# The bearer token Chord will send. Make up a long random string and use the
# SAME value here and in Chord's tool config (auth_type: bearer, this as the token).
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Paystack TEST secret key (starts with sk_test_). From your Paystack dashboard.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Google Sheet that holds the ledger.
SHEET_ID=the-long-id-from-the-sheet-url
SHEET_TAB=Ledger

# Secret code the owner says to unlock business totals (works in any channel).
# Pick something only you know. Leave blank to allow anyone (not recommended).
OWNER_CODE=mamat-2026

# The whole service-account JSON key, on ONE line (stringified). The service
# account's client_email must be shared as an Editor on the sheet.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com", "...":"..."}
